<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <!-- La configuracion local (contraseñas) no esta en el repositorio: cada instalacion crea
       su propio configuracion.local.json a partir de configuracion.ejemplo.json. Si existe,
       se copia junto al ejecutable al compilar. -->
  <ItemGroup>
    <None Update="configuracion.local.json" Condition="Exists('configuracion.local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>